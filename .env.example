# Environment Variables Template
# Copy this file to .env and update with your own values

# Database Configuration
DB_PASSWORD=YourStrong@Passw0rd

# JWT Configuration (Generate a new secret for production!)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
JWT_ISSUER=StudentPortal
JWT_AUDIENCE=StudentPortalClient

# Database Seeding (set to false in production)
SEED_DATA=true
SEED_STUDENT_EMAIL=student@test.com
SEED_STUDENT_PASSWORD=Student123!
SEED_TEACHER_EMAIL=teacher@test.com
SEED_TEACHER_PASSWORD=Teacher123!
SEED_ADMIN_EMAIL=admin@test.com
SEED_ADMIN_PASSWORD=Admin123!
